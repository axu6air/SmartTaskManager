{
    "Serilog": {
        "Using": ["Serilog.Sinks.Console"],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning",
                "System.Net.Http.HttpClient": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
                }
            }
        ]
    },
    "AllowedHosts": "*",
    "Database": {
        "ConnectionString": "[SEE USER SECRETS]",
        "MaxRetryCount": 5,
        "MaxRetryDelaySeconds": 30,
        "SlowQueryThreshold": 500
    },
    "Jwt": {
        "Issuer": "SmartTaskManager",
        "Audience": "SmartTaskManager.Client",
        "TokenExpiry": 120,
        "RefreshTokenExpiry": 7,
        "SecretKey": "[SEE USER SECRETS]"
    },
    "Cors": {
        "AllowedOrigins": ["http://localhost:4200"]
    },
    "RateLimiting": {
        "WindowSeconds": 60,
        "GlobalPermitLimit": 100,
        "AuthPermitLimit": 10,
        "AiPermitLimit": 10
    },
    "OpenRouter": {
        "ApiKey": "[SEE USER SECRETS]",
        "BaseUrl": "https://openrouter.ai/api/v1",
        "ChatModel": "nvidia/nemotron-3.5-lightning:free",
        "TimeoutSeconds": 30,
        "MaxRetries": 2
    }
}
