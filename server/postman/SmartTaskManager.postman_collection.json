{
  "info": {
    "name": "Smart Task Manager API",
    "description": "Every endpoint of the Smart Task Manager backend.\n\n1. Run **Auth / Login** first: it stores the access and refresh tokens in collection variables, and every other request sends the access token as a Bearer token.\n2. **Projects / Create project** stores `projectId`, and **Tasks / Create task** stores `taskId`, so the later requests work in order.\n3. Set `userId` (a user to add to a project) and `assigneeId` (a project member) before the assign requests.\n\nThe demo users (all with password `password123`) exist in Development only: admin@email.com, manager1@email.com, manager2@email.com, member11@email.com, member21@email.com.\n\nTask priority is a number: 1 Low, 2 Medium, 3 High, 4 Critical. Status is 1 ToDo, 2 InProgress, 3 Completed, 4 Cancelled.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5235"
    },
    {
      "key": "email",
      "value": "manager1@email.com"
    },
    {
      "key": "password",
      "value": "password123"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "assigneeId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Signs in with email and password. 400 for an invalid body, 401 for wrong credentials.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success) {",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "List projects",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects?page=1&pageSize=30",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "30"
                }
              ]
            },
            "description": "Permission projects.view. Returns only the projects the user's scope allows."
          }
        },
        {
          "name": "Get project",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}"
              ]
            },
            "description": "Permission projects.view. Includes the members."
          }
        },
        {
          "name": "Create project",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects"
              ]
            },
            "description": "Permission projects.create. The creator becomes the first manager. 409 if the name is taken.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Apollo\",\n  \"description\": \"Moon landing\",\n  \"startDate\": \"2030-01-01T00:00:00Z\",\n  \"endDate\": \"2030-12-31T00:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success && body.data) { pm.collectionVariables.set('projectId', body.data.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Update project",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}"
              ]
            },
            "description": "Permission projects.update.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Apollo v2\",\n  \"description\": \"Moon landing\",\n  \"startDate\": \"2030-01-01T00:00:00Z\",\n  \"endDate\": \"2030-12-31T00:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete project",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}"
              ]
            },
            "description": "Permission projects.delete. Soft delete, returns 204."
          }
        },
        {
          "name": "Assign project member",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/assign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "assign"
              ]
            },
            "description": "Permission projects.manage_members. Adds the user, or changes their manager flag if already a member. A project must keep at least one manager.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"isManager\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "List tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks?page=1&pageSize=30",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "tasks"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "30"
                }
              ]
            },
            "description": "Permission tasks.view. Returns only the tasks the user's scope allows."
          }
        },
        {
          "name": "Get task",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "tasks",
                "{{taskId}}"
              ]
            },
            "description": "Permission tasks.view."
          }
        },
        {
          "name": "Create task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "tasks"
              ]
            },
            "description": "Permission tasks.create. The assignee, if given, must be a project member. The due date cannot be in the past.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Design the lander\",\n  \"description\": \"First draft\",\n  \"priority\": 2,\n  \"dueDate\": \"2030-06-01T00:00:00Z\",\n  \"assigneeId\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success && body.data) { pm.collectionVariables.set('taskId', body.data.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Update task",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "tasks",
                "{{taskId}}"
              ]
            },
            "description": "Permission tasks.update.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Design the lander v2\",\n  \"description\": \"Second draft\",\n  \"priority\": 3,\n  \"dueDate\": \"2030-06-15T00:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete task",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "tasks",
                "{{taskId}}"
              ]
            },
            "description": "Permission tasks.delete. Soft delete, returns 204."
          }
        },
        {
          "name": "Assign task",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks/{{taskId}}/assign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "tasks",
                "{{taskId}}",
                "assign"
              ]
            },
            "description": "Permission tasks.assign. The assignee must be a project member. Send null to unassign.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assigneeId\": \"{{assigneeId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
